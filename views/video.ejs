  <!-- Structured data — VideoObject. Den här sidan ÄR videons watch page:
       sidans syfte är att spela filmen. Därför bor schemat här och inte på
       startsidan (Google indexerar bara video som ligger på en watch page). -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "Joakim Jaksen — introduktion till säljakademin",
    "description": "Joakim Jaksen presenterar säljakademin: 22+ års säljerfarenhet, bolag som omsatt 200+ MSEK och 1000+ tränade säljare. <%= blocks.length %> utbildningsblock som täcker hela säljprocessen — från första intrycket till mental styrka, AI-verktyg och rekommenderad läsning.",
    "thumbnailUrl": "https://joakimjaksen.se/videos/joakim-jaksen-intro-poster.jpg",
    "uploadDate": "2026-06-01T00:00:00+02:00",
    "duration": "PT1M45S",
    "contentUrl": "https://joakimjaksen.se/videos/joakim-jaksen-intro.mp4",
    "embedUrl": "https://joakimjaksen.se/video",
    "publisher": {
      "@type": "Person",
      "name": "Joakim Jaksen",
      "url": "https://joakimjaksen.se"
    },
    "inLanguage": "sv"
  }
  </script>

  <style>
    .vid-wrap{background:#0f172a;border:1px solid rgba(255,255,255,0.08);border-radius:16px;overflow:hidden;
              box-shadow:0 18px 44px rgba(0,0,0,0.45);}
    .vid-wrap video{display:block;width:100%;height:auto;background:#000;}
    .vid-meta{display:flex;gap:1.25rem;flex-wrap:wrap;color:#94a3b8;font-size:0.85rem;margin-top:0.85rem;}
    .vid-facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0.75rem;margin:2rem 0;}
    .vid-fact{background:#141a2c;border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:1rem;text-align:center;}
    .vid-fact strong{display:block;font-size:1.5rem;color:#f1f5f9;}
    .vid-fact span{font-size:0.78rem;color:#94a3b8;}
    @media (max-width:640px){ .vid-h1{font-size:1.6rem !important;} }
